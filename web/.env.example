# Vite dev server: where /api, /auth, /oauth and /health are proxied (backend FastAPI).
ERP_DEV_API_TARGET=
# 1 = serve stubbed /auth/* and /health from the dev server (no backend needed).
ERP_API_MOCK=
# OpenAPI schema source for `pnpm api:fetch` (default http://localhost:8000/openapi.json).
ERP_OPENAPI_URL=
