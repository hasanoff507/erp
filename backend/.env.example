# Backend settings (app/core/config.py, prefix ERP_). Names only — values come from
# the local .env (never committed) or, on servers, from SOPS/age secrets (qaror #57, #65).
ERP_ENVIRONMENT=
ERP_APP_NAME=
ERP_API_PREFIX=
# erp_app (RLS-bound) and erp_migrator (Alembic) connection URLs, postgresql+asyncpg://...
ERP_DATABASE_URL=
ERP_MIGRATOR_DATABASE_URL=
ERP_DB_POOL_SIZE=
ERP_DB_MAX_OVERFLOW=
ERP_DB_ECHO=
ERP_REDIS_URL=
ERP_QUEUE_NAME=
ERP_WORKER_CONCURRENCY=
ERP_AUTH_ENABLED=
# itsdangerous key: __Host-sid cookie + CSRF synchronizer token
ERP_AUTH_SECRET=
# OAuth AS issuer / first-party origin, e.g. https://app.example.uz
ERP_PUBLIC_BASE_URL=
# envelope-encryption KEK: urlsafe base64 of 32 random bytes (15 §4.2); JSON map for old versions
ERP_KEK=
ERP_KEK_VERSION=
ERP_KEK_PREVIOUS=
ERP_WEB_BFF_CLIENT_SECRET=
ERP_ACCESS_TOKEN_TTL_S=
ERP_SYNC_DRAIN_TOKEN_TTL_S=
ERP_AUTH_CODE_TTL_S=
ERP_SESSION_IDLE_S=
ERP_SESSION_ABSOLUTE_S=
ERP_SIGNING_KEY_OVERLAP_S=
ERP_SESSION_CHECK_CACHE_S=
ERP_REFRESH_LOCK_TTL_S=
ERP_LOGIN_MAX_FAILURES=
ERP_LOGIN_FAILURE_WINDOW_S=
ERP_LOGIN_IP_FAILURES_PER_HOUR=
ERP_TOKEN_REQUESTS_PER_MINUTE=
ERP_LOGIN_ATTEMPTS_RETENTION_DAYS=
# fake | cli | api (prod: api only)
ERP_AI_MODE=
# anthropic | bedrock_eu
ERP_AI_PII_ROUTE=
# fake | partner_cloud | multikassa_local | fiscaldrive_local
ERP_FISCAL_PROVIDER=
ERP_FX_USD_UZS_FALLBACK=
ERP_IDEMPOTENCY_LOCK_TTL_S=
ERP_IDEMPOTENCY_RETENTION_DAYS=
ERP_LOG_LEVEL=
ERP_LOG_JSON=
# JSON list, e.g. ["http://localhost:5173"]
ERP_CORS_ORIGINS=
# --- Bosqich 1: auth/signup slice (OTP 14 §4.2/§12, Telegram 21 §11, Eskiz 21 §10, Google 14 §2.2) ---
ERP_OTP_TTL_S=
ERP_OTP_TELEGRAM_PER_PHONE_DAY=
ERP_OTP_TELEGRAM_PER_IP_HOUR=
ERP_OTP_SMS_PER_PHONE_DAY=
ERP_OTP_SMS_PER_IP_HOUR=
ERP_OTP_SMS_DAILY_BUDGET=
ERP_OTP_VERIFIED_TTL_S=
ERP_OTP_RECOVERY_MIN_RESPONSE_MS=
ERP_OTP_VERIFY_PER_IP_HOUR=
ERP_OTP_VERIFY_FAIL_PER_PHONE_DAY=
# local/test only — refused in staging/prod (qaror #34)
ERP_OTP_DEV_FAKES=
# JSON list of +998 test numbers; requires ERP_OTP_TEST_CODE (6 digits)
ERP_OTP_TEST_PHONES=
ERP_OTP_TEST_CODE=
ERP_CREDENTIAL_TOKEN_TTL_S=
ERP_SIGNUP_PER_IP_HOUR=
ERP_TELEGRAM_BOT_TOKEN=
ERP_TELEGRAM_API_BASE_URL=
# M18 bot (21 §11): username for the t.me deep link, webhook secret_token, link code TTL; fake — not in prod
ERP_TELEGRAM_BOT_USERNAME=
ERP_TELEGRAM_WEBHOOK_SECRET=
ERP_TELEGRAM_LINK_CODE_TTL_S=
ERP_TELEGRAM_FAKE=
ERP_ESKIZ_TEST_MODE=
ERP_ESKIZ_BASE_URL=
ERP_ESKIZ_EMAIL=
ERP_ESKIZ_PASSWORD=
ERP_ESKIZ_SENDER=
ERP_SMS_BRAND=
ERP_OUTBOUND_HTTP_TIMEOUT_S=
ERP_GOOGLE_CLIENT_ID=
ERP_GOOGLE_CLIENT_SECRET=
ERP_GOOGLE_ANDROID_CLIENT_IDS=
ERP_GOOGLE_AUTH_URL=
ERP_GOOGLE_TOKEN_URL=
ERP_GOOGLE_JWKS_URL=
ERP_GOOGLE_ISSUERS=
# --- Bosqich 1: catalog/pricing/import slice (MXIK 21 §7, import-jobs 17 §12 / 19 §6) ---
# tasnif | fake (fake: local/test only — refused in staging/prod, qaror #34)
ERP_MXIK_PROVIDER=
ERP_MXIK_BASE_URL=
ERP_MXIK_TIMEOUT_S=
ERP_MXIK_RETRY_BASE_S=
ERP_MXIK_RETRY_CAP_S=
ERP_MXIK_MAX_ATTEMPTS=
ERP_MXIK_CACHE_FRESH_S=
ERP_MXIK_CACHE_TTL_S=
ERP_IMPORT_MAX_BYTES=
ERP_IMPORT_MAX_ROWS=
# uploaded files until the S3 StoragePort lands; API and worker must share it
ERP_FILE_STORAGE_DIR=
# --- Bosqich 2: purchasing/debts slice (e-invoice operator 21 §2) ---
# faktura_uz | fake (fake: local/test/staging only — refused in prod, 27 Bosqich 2)
ERP_EINVOICE_PROVIDER=
# --- Bosqich 3: device-auth slice (14 §7.2 device-bound login 14 d / 180 d, §12 PIN lockout, 16 §9) ---
ERP_DEVICE_SESSION_IDLE_S=
ERP_DEVICE_SESSION_ABSOLUTE_S=
ERP_DEVICE_COOKIE_MAX_AGE_S=
ERP_PIN_MAX_FAILURES=
ERP_PIN_FAILURE_WINDOW_S=
ERP_PIN_USER_FAILURES_PER_DAY=
ERP_PIN_REVOKE_LOOKBACK_DAYS=
ERP_ACTOR_BINDING_TTL_S=
# --- Bosqich 3: cash slice (18 §9.1: approval_requests.expires_at = requested_at + N minutes, default 15) ---
ERP_APPROVAL_TTL_MINUTES=
# --- Bosqich 3: card slice (21 §9.4: adapter='fake' card terminals — dev/test/staging only, refused in prod) ---
ERP_CARD_FAKE_TERMINALS=
# --- Bosqich 3: sync slice (16 §3.1/§8, qaror #54: batch 100, 5 req/s per device, 4 parallel pushes per tenant) ---
ERP_SYNC_PUSH_MAX_EVENTS=
ERP_SYNC_PUSH_RATE_PER_S=
ERP_SYNC_PUSH_TENANT_CONCURRENCY=
ERP_SYNC_PUSH_LOCK_TTL_S=
ERP_SYNC_CLOCK_SKEW_WARN_S=
ERP_SYNC_OFFLINE_CLAMP_WINDOW_S=
ERP_SYNC_PULL_PAGE_SIZE=
ERP_SYNC_PULL_MAX_PAGE_SIZE=
ERP_SYNC_PULL_SETTLE_S=
# --- telemetry (23 §8, 25 §5) — all off by default; local/test need no collector ---
ERP_METRICS_ENABLED=
# bearer token Prometheus sends to /metrics; >= 32 chars, required in staging/prod when metrics are on
ERP_METRICS_TOKEN=
# SAQ worker/scheduler metrics listener (empty = off)
ERP_WORKER_METRICS_PORT=
ERP_WORKER_METRICS_HOST=
ERP_OTEL_ENABLED=
# OTLP/HTTP base URL of Grafana Tempo, e.g. http://tempo:4318
ERP_OTEL_EXPORTER_OTLP_ENDPOINT=
ERP_OTEL_SAMPLE_RATIO=
ERP_SENTRY_DSN=
