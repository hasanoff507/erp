# /etc/systemd/system/erp-wal-receive.service — continuous WAL archive (qaror #51, RPO <= 5 min)
[Unit]
Description=ERP WAL-G wal-receive (DBaaS -> UzCloud S3, encrypted)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=erp-backup
Environment=ERP_BACKUP_ENV_FILE=/etc/erp-backup/env
ExecStart=/opt/erp/backend/ops/backup/wal-receive.sh
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
