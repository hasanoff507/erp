# Vite dev server: where /api, /auth, /oauth and /health are proxied (backend FastAPI).
ERP_DEV_API_TARGET=
# 1 = serve stubbed /auth/* and /health from the dev server (no backend needed).
ERP_API_MOCK=
# OpenAPI schema source for `pnpm api:fetch` (default http://localhost:8000/openapi.json).
ERP_OPENAPI_URL=
# CSP style source (24 §4.4): "nonce" (default — the server of index.html mints one per response)
# or "hash" (static host without nonces: sha256 list of the Radix <style> texts + dist/_headers).
ERP_CSP_MODE=
