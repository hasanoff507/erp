<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Library</OutputType>
    <!-- test-only relaxations: xunit naming (CA1707), no ConfigureAwait in tests (CA2007), test helpers -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1515;CA1062;CA1861;CA1859;CA1822;CA1849;CA2201;CA1031;CA5394;CA1001;CA2000;CA1305;CA1307;CA1310;CA1309;CA1862;CA1866;CA1847;CA1865;CA1869;CA1816;CA1063</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Common\*.cs" Link="Common\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
