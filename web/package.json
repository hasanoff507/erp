{
  "name": "erp-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=shell",
    "dev:mock": "turbo run dev:mock --filter=shell",
    "build": "turbo run build",
    "preview": "pnpm --filter shell preview",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter shell test:e2e",
    "api:gen": "node scripts/api-gen.mjs",
    "api:fetch": "node scripts/api-gen.mjs --fetch",
    "api:export": "node scripts/api-gen.mjs --export",
    "api:check": "node scripts/api-gen.mjs --check",
    "audit": "pnpm audit --audit-level=high",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css}\""
  },
  "devDependencies": {
    "orval": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
